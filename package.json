{
  "name": "fdmst",
  "version": "1.0.0",
  "description": "Flores-Dizon Dental Clinic Management System",
  "private": true,
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "lint": "eslint src",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm run test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0"
  },
  "nodemonConfig": {
    "ignore": [
      "src/",
      "public/",
      "dist/",
      "tests/",
      ".mongo/",
      "*.mjs"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "mongoose": "^9.7.0",
    "morgan": "^1.11.0",
    "react": "^19.2.6",
    "react-big-calendar": "^1.20.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.78.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.17.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
