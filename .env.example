PORT=5050
HOST=0.0.0.0
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/fdmst_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=1
API_RATE_LIMIT=500
AUTH_RATE_LIMIT=30
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FIRST_NAME=Clinic
ADMIN_SEED_LAST_NAME=Administrator
MAIL_API_URL=https://your-mail-api.example/send
MAIL_API_KEY=replace-with-your-mail-api-key
MAIL_FROM_NAME=Flores-Dizon Dental Clinic
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
SUPABASE_STORAGE_BUCKET=fdmst-images
SUPABASE_CLINICAL_STORAGE_BUCKET=fdmst-clinical-files
SUPABASE_CHAT_STORAGE_BUCKET=fdmst-chat-files
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Frontend (read by Vite at build time). Leave empty: production builds call /api
# on the same domain that serves the app. Set it only to use a different API URL.
VITE_API_URL=
